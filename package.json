{
  "name": "@hedles/examples",
  "version": "0.1.0",
  "private": true,
  "description": "Runnable Hedles API examples for Bun and TypeScript",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hedlesio/examples.git"
  },
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "claim": "bun examples/claim-tenant.ts",
    "merchant-otp": "bun examples/onboard-merchant-with-otp.ts",
    "merchant-otp-renew": "bun examples/renew-merchant-otp.ts",
    "session": "bun examples/get-session.ts",
    "wallet": "bun examples/create-wallet.ts",
    "payin": "bun examples/create-payin.ts",
    "payout": "bun examples/create-payout.ts",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx biome check .",
    "format": "bunx biome check --write .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun test"
  },
  "dependencies": {
    "@turnkey/api-key-stamper": "^0.6.8",
    "@turnkey/crypto": "^2.10.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/bun": "latest",
    "typescript": "^7"
  }
}
